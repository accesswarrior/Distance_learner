// firestore.rules — Werewolf-specific section
//
// IMPORTANT: this project (access-warrior-1d789) is shared with the
// ELTP Quiz Hub. Do NOT deploy this file as-is if the Quiz Hub already
// has its own firestore.rules — that would overwrite its rules.
// Instead, copy the `match` blocks below (functions included) into the
// *same* `match /databases/{database}/documents { ... }` block that
// already contains the Quiz Hub's rules.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Werewolf game rules (merge these into the existing block) ---

    // Helper functions, scoped so they only ever look at werewolf_ data.
    function signedIn() {
      return request.auth != null;
    }

    function isModerator(sessionId) {
      return get(/databases/$(database)/documents/werewolf_sessions/$(sessionId)).data.moderatorId == request.auth.uid;
    }

    function isPlayerInSession(sessionId) {
      return exists(/databases/$(database)/documents/werewolf_sessions/$(sessionId)/players/$(request.auth.uid));
    }

    function myPlayerData(sessionId) {
      return get(/databases/$(database)/documents/werewolf_sessions/$(sessionId)/players/$(request.auth.uid)).data;
    }

    // A "participant" is the moderator or anyone with a players/{uid} doc
    // in this specific session — used to scope writes to people actually
    // in that room, instead of any signed-in user app-wide.
    function isParticipant(sessionId) {
      return isModerator(sessionId) || isPlayerInSession(sessionId);
    }

    // True only for the one alive player currently holding `role` in this
    // session. Used to give the Seer (and only the Seer) permission to
    // read another player's role — that read IS the Seer's ability.
    function amAliveRole(sessionId, role) {
      return isPlayerInSession(sessionId)
        && myPlayerData(sessionId).role == role
        && myPlayerData(sessionId).alive != false;
    }

    // True only while the session names ME as the player about to take a
    // Hunter's revenge shot. Time-boxed: the app clears
    // session.pendingHunterShot the instant the shot is fired (or skipped),
    // so this permission only exists for that one brief window.
    function isPendingHunterShot(sessionId) {
      return get(/databases/$(database)/documents/werewolf_sessions/$(sessionId)).data.pendingHunterShot == request.auth.uid;
    }

    match /werewolf_usernames/{username} {
      allow read: if false; // only used server-side (client checks existence, not content)
      allow create: if signedIn();
    }

    match /werewolf_users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      // Account owner can update their own currentSessionId (resume-a-room
      // pointer) and displayName (the in-game name shown to other players,
      // separate from their login username).
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentSessionId', 'displayName']);
    }

    match /werewolf_sessions/{sessionId} {
      allow read: if signedIn(); // must stay open: joining-by-code happens before you're a participant
      allow create: if signedIn();
      // Only the moderator moves the session forward normally (start game,
      // open/close voting, start/advance/end night). The one exception: the
      // player currently taking a Hunter's revenge shot can clear
      // pendingHunterShot and set the announcement once they fire — nothing
      // else on the session doc.
      allow update: if signedIn() && (
        isModerator(sessionId) ||
        (isPendingHunterShot(sessionId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingHunterShot', 'announcement']))
      );

      match /players/{playerId} {
        // Only the doc owner, the moderator, the session's alive Seer (to
        // check a role), or the session's alive Witch reading specifically
        // the Chief Werewolf's nightAction doc (handled below, not here)
        // can read a given player doc.
        allow read: if signedIn() && (
          request.auth.uid == playerId ||
          isModerator(sessionId) ||
          amAliveRole(sessionId, 'seer')
        );
        allow create: if signedIn() && request.auth.uid == playerId;
        // Doc owner (ready toggle, Witch's own potion flags, Hunter's own
        // shot-used flag), the moderator (role assignment, elimination,
        // kicking), or — narrowly — the player currently taking a Hunter's
        // revenge shot, who needs to eliminate someone who isn't themself.
        allow update: if signedIn() && (
          request.auth.uid == playerId ||
          isModerator(sessionId) ||
          isPendingHunterShot(sessionId)
        );
        allow delete: if signedIn() && isModerator(sessionId);
      }

      match /votes/{voterId} {
        allow read: if signedIn() && isParticipant(sessionId);
        allow create, update: if signedIn() && request.auth.uid == voterId;
        // Only the moderator's reveal step clears vote docs between rounds.
        allow delete: if signedIn() && isModerator(sessionId);
      }

      // Private night actions (Doctor's save, Chief Werewolf's kill, Witch's
      // save/poison, Seer's own check isn't stored here). Only the alive
      // player holding that specific role may write to it. Reads are
      // normally the same restriction, PLUS one narrow exception: the alive
      // Witch may read the Chief Werewolf's target specifically — that read
      // IS her ability, the same way the Seer's player-doc read is hers.
      // She still can't read the Doctor's or Seer's actions.
      match /nightActions/{role} {
        allow read: if signedIn() && (
          isModerator(sessionId) ||
          amAliveRole(sessionId, role) ||
          (role == 'chief_werewolf' && amAliveRole(sessionId, 'witch'))
        );
        allow create, update: if signedIn() && amAliveRole(sessionId, role);
        allow delete: if signedIn() && isModerator(sessionId);
      }
    }

    // --- Quiz Hub rules go here too — do not remove them when merging ---

  }
}
